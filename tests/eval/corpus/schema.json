{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luma-ai-dmx.local/schemas/song-to-show-corpus-v1.schema.json",
  "title": "Song-to-Show annotated reference track",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "trackId",
    "metadata",
    "audio",
    "tempoSegments",
    "beats",
    "bars",
    "sections",
    "review"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "trackId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,79}$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "artist",
        "durationSeconds",
        "genre"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "artist": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "releaseYear": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "genre": {
          "type": "string",
          "minLength": 1
        },
        "subgenres": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "language": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "sourceUrl": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 8000
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "tempoSegments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "startSeconds",
          "endSeconds",
          "bpm",
          "timeSignature"
        ],
        "properties": {
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "bpm": {
            "type": "number",
            "minimum": 20,
            "maximum": 400
          },
          "timeSignature": {
            "type": "string",
            "pattern": "^[1-9][0-9]*/[1248]$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "timeSeconds",
          "bar",
          "beat"
        ],
        "properties": {
          "timeSeconds": {
            "type": "number",
            "minimum": 0
          },
          "bar": {
            "type": "integer",
            "minimum": 1
          },
          "beat": {
            "type": "integer",
            "minimum": 1
          },
          "isDownbeat": {
            "type": "boolean"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "bars": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "startSeconds",
          "endSeconds"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "label",
          "startSeconds",
          "endSeconds"
        ],
        "properties": {
          "type": {
            "enum": [
              "intro",
              "verse",
              "pre-chorus",
              "chorus",
              "bridge",
              "breakdown",
              "drop",
              "instrumental",
              "solo",
              "outro",
              "silence",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "startSeconds": {
            "type": "number",
            "minimum": 0
          },
          "endSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "annotator",
        "reviewedAt"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "annotated",
            "verified"
          ]
        },
        "annotator": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string"
        },
        "reviewedAt": {
          "type": "string",
          "format": "date-time"
        },
        "method": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
